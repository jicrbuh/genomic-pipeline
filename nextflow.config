process {
    withName: FASTQC { container = 'biocontainers/fastqc:v0.11.9_cv8' }
    withName: BWA_ALIGN { container = 'biocontainers/bwa:v0.7.17_cv1' }
}

profiles {
    standard {
        docker.enabled = true
    }
    awsbatch {
        process.executor = 'awsbatch'
        process.queue = 'your-batch-queue-name'
        workDir = 's3://your-bucket/work'
        aws.region = 'us-east-1'
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
    }
}
